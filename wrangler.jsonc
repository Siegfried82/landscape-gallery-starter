{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landscape-gallery-starter",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "none" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "gallery-db",
    // Replace this placeholder with the ID returned by `wrangler d1 create gallery-db`.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "./drizzle"
  }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "gallery-photos" }]
}
